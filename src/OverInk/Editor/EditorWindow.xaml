<Window x:Class="OverInk.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:toolbar="clr-namespace:OverInk.Toolbar"
        xmlns:local="clr-namespace:OverInk.Editor"
        Title="OverInk Editor"
        Width="1240"
        Height="780"
        MinWidth="820"
        MinHeight="520"
        Background="#FF0E0E10"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF121214" />
        <SolidColorBrush x:Key="PanelEdgeBrush" Color="#1FFFFFFF" />

        <!-- Icon button: dock style that dims when disabled -->
        <Style x:Key="EdIconButton" TargetType="Button" BasedOn="{StaticResource DockButton}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Icon (+ optional text) pill used for zoom presets and tray toggles -->
        <Style x:Key="EdPill" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#E0E0E6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outlined secondary action (Save as…) -->
        <Style x:Key="EdSecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FF1C1C20" />
            <Setter Property="BorderBrush" Value="#28FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF28282E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF303038" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Library cards -->
        <Style x:Key="TrayItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="#FF18181B" BorderBrush="#18FFFFFF" BorderThickness="1.5"
                                CornerRadius="12" Padding="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FF202024" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FF1B2436" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CropHandle" TargetType="Border">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Top bar ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelEdgeBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- History -->
                    <Button x:Name="UndoButton" Style="{StaticResource EdIconButton}" Click="Undo_Click"
                            IsEnabled="False" ToolTip="Undo (Ctrl+Z)">
                        <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconUndo}" />
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource EdIconButton}" Click="Redo_Click"
                            IsEnabled="False" ToolTip="Redo (Ctrl+Y)">
                        <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconRedo}" />
                    </Button>

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <!-- Zoom -->
                    <Button Style="{StaticResource EdIconButton}" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+-)">
                        <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconMinus}" />
                    </Button>
                    <TextBlock x:Name="ZoomLabel" Text="100%" Width="44" TextAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="Medium" />
                    <Button Style="{StaticResource EdIconButton}" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl++)">
                        <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconPlus}" />
                    </Button>
                    <ToggleButton x:Name="FitToggle" Style="{StaticResource DockToolToggle}" IsChecked="True"
                                  Click="FitZoom_Click" Margin="6,1,1,1" ToolTip="Fit to window (Ctrl+0)">
                        <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconScan}" />
                    </ToggleButton>
                    <Button Style="{StaticResource EdPill}" Click="ActualZoom_Click" Content="1:1"
                            ToolTip="Actual size, 100% (Ctrl+1)" />
                </StackPanel>

                <!-- Document -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="DocTitle" HorizontalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                    <TextBlock x:Name="DocMeta" HorizontalAlignment="Center" Style="{StaticResource MutedLabel}"
                               FontSize="10.5" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border x:Name="StatusPill" Background="#1A4C8DFF" CornerRadius="9" Padding="10,5"
                            Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=StatusLabel}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="StatusLabel" FontSize="11.5" FontWeight="Medium" Foreground="#FF9DBEFF" />
                    </Border>

                    <Button x:Name="CopyButton" Style="{StaticResource PrimaryButton}" Click="Copy_Click"
                            Margin="0,0,8,0" Padding="14,0" ToolTip="Copy image to clipboard (Ctrl+C)">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconCopy}"
                                            Width="15" Height="15" Margin="0,0,7,0" />
                            <TextBlock Text="Copy" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SaveAsButton" Style="{StaticResource EdSecondaryButton}" Click="Save_Click"
                            ToolTip="Save a copy as PNG (Ctrl+Shift+S)">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconDownload}"
                                            Width="15" Height="15" Margin="0,0,7,0" />
                            <TextBlock Text="Save as…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Right panel ===== -->
        <Border x:Name="ToolsPanel" DockPanel.Dock="Right" Width="280" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelEdgeBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,16,12,16">

                    <!-- Tools -->
                    <TextBlock Text="TOOLS" Style="{StaticResource SectionLabel}" />
                    <Border Background="#12FFFFFF" CornerRadius="12" Padding="2" HorizontalAlignment="Left" Margin="0,0,0,22">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="PenToggle" Tag="Pen" Style="{StaticResource DockToolToggle}" IsChecked="True"
                                          Click="Tool_Click" ToolTip="Pen (P)">
                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconPen}" />
                            </ToggleButton>
                            <ToggleButton x:Name="LineToggle" Tag="Line" Style="{StaticResource DockToolToggle}"
                                          Click="Tool_Click" ToolTip="Line (L) — hold Shift for 45° steps">
                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconLine}" />
                            </ToggleButton>
                            <ToggleButton x:Name="ArrowToggle" Tag="Arrow" Style="{StaticResource DockToolToggle}"
                                          Click="Tool_Click" ToolTip="Arrow (A) — hold Shift for 45° steps">
                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconArrow}" />
                            </ToggleButton>
                            <ToggleButton x:Name="RectangleToggle" Tag="Rectangle" Style="{StaticResource DockToolToggle}"
                                          Click="Tool_Click" ToolTip="Rectangle (R) — hold Shift for a square">
                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconRectangle}" />
                            </ToggleButton>
                            <ToggleButton x:Name="EllipseToggle" Tag="Ellipse" Style="{StaticResource DockToolToggle}"
                                          Click="Tool_Click" ToolTip="Ellipse (O) — hold Shift for a circle">
                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconEllipse}" />
                            </ToggleButton>
                            <ToggleButton x:Name="EraserToggle" Tag="Eraser" Style="{StaticResource DockToolToggle}"
                                          Click="Tool_Click" ToolTip="Eraser (E) — removes whole strokes and shapes">
                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconEraser}" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>
                    <!-- Pen -->
                    <StackPanel x:Name="PenSection">
                        <TextBlock Text="COLOR" Style="{StaticResource SectionLabel}" />
                        <WrapPanel x:Name="PresetSwatchesPanel" Margin="-1,0,0,0" />

                        <Grid Margin="0,10,0,0" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonUp="CustomColorRow_Click">
                            <ToggleButton x:Name="CustomColorButton" Style="{StaticResource ColorWheelButton}"
                                          HorizontalAlignment="Left" Margin="1,0,0,0" Click="CustomColorButton_Click" />
                            <TextBlock Text="Custom color" Style="{StaticResource RowTitle}" Margin="34,0,0,0"
                                       VerticalAlignment="Center" />
                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconChevronDown}"
                                            Width="14" Height="14" HorizontalAlignment="Right"
                                            Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>
                        <Border x:Name="CustomColorCard" Visibility="Collapsed" Background="#FF18181B" CornerRadius="12"
                                Padding="12" Margin="0,10,0,0">
                            <toolbar:ColorPickerControl x:Name="EditorColorPicker" HorizontalAlignment="Center" />
                        </Border>

                        <Grid Margin="0,22,0,10">
                            <TextBlock Text="STROKE WIDTH" Style="{StaticResource SectionLabel}" Margin="0" />
                            <TextBlock x:Name="PenSizeValue" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="44" CornerRadius="12" Background="#12FFFFFF">
                                <Viewbox Width="34" Height="29" Stretch="Uniform">
                                    <Canvas Width="28" Height="24">
                                        <Path x:Name="StrokePreviewPath" Data="{StaticResource StrokeCurve}"
                                              Stroke="#FFE53935" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <Slider x:Name="PenSizeSlider" Grid.Column="1" Style="{StaticResource ThemedSlider}"
                                    Margin="14,0,0,0" VerticalAlignment="Center" Minimum="1" Maximum="24" Value="4"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="PenSizeSlider_ValueChanged" />
                        </Grid>
                    </StackPanel>

                    <!-- Eraser hint (replaces the pen controls while erasing) -->
                    <Border x:Name="EraserHint" Visibility="Collapsed" Background="#FF18181B" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconEraser}"
                                                Width="16" Height="16" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="Eraser" Style="{StaticResource RowTitle}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Click or drag across a stroke or shape to remove it. Press P to go back to the pen."
                                       Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{StaticResource PanelEdgeBrush}" Margin="0,22,0,18" />

                    <!-- Crop -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconCrop}"
                                        Width="15" Height="15" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="CROP" Style="{StaticResource SectionLabel}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Drag the handles on the image edges. The crop applies as soon as you let go, and Ctrl+Z brings it back."
                               Style="{StaticResource RowDesc}" Margin="0" />

                    <Border Height="1" Background="{StaticResource PanelEdgeBrush}" Margin="0,22,0,18" />

                    <!-- Shortcuts -->
                    <TextBlock Text="SHORTCUTS" Style="{StaticResource SectionLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="P / E" Style="{StaticResource RowTitle}" FontSize="11.5" Margin="0,0,16,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Pen / Eraser" Style="{StaticResource MutedLabel}" />
                        <TextBlock Grid.Row="1" Text="L A R O" Style="{StaticResource RowTitle}" FontSize="11.5" Margin="0,0,16,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Line, arrow, rect, oval" Style="{StaticResource MutedLabel}" />
                        <TextBlock Grid.Row="2" Text="Shift" Style="{StaticResource RowTitle}" FontSize="11.5" Margin="0,0,16,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Snap angle / square" Style="{StaticResource MutedLabel}" />
                        <TextBlock Grid.Row="3" Text="Ctrl+Z / Y" Style="{StaticResource RowTitle}" FontSize="11.5" Margin="0,0,16,6" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Undo / Redo" Style="{StaticResource MutedLabel}" />
                        <TextBlock Grid.Row="4" Text="Ctrl+C" Style="{StaticResource RowTitle}" FontSize="11.5" Margin="0,0,16,6" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Copy image" Style="{StaticResource MutedLabel}" />
                        <TextBlock Grid.Row="5" Text="Ctrl+wheel" Style="{StaticResource RowTitle}" FontSize="11.5" Margin="0,0,16,0" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Zoom" Style="{StaticResource MutedLabel}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== Library tray ===== -->
        <Border x:Name="TrayPanel" DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelEdgeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" MinHeight="56" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="16,8,10,4">
                    <Button DockPanel.Dock="Right" Style="{StaticResource EdPill}" Click="ToggleTray_Click"
                            ToolTip="Hide library">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconChevronDown}"
                                            Width="14" Height="14" Margin="0,0,6,0" />
                            <TextBlock Text="Hide" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource LucideIcon}"
                                    Tag="{StaticResource IconImages}" Width="15" Height="15"
                                    Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="LIBRARY" Style="{StaticResource SectionLabel}" Margin="8,0,0,0"
                               VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <TextBlock x:Name="TrayCountLabel" Style="{StaticResource MutedLabel}" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </DockPanel>

                <ListBox x:Name="LibraryList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         Margin="10,0,10,8" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource TrayItemStyle}"
                         SelectionChanged="LibraryList_SelectionChanged"
                         PreviewMouseLeftButtonDown="LibraryList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="LibraryList_PreviewMouseMove">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="132" Tag="{Binding}" Background="Transparent"
                                        MouseRightButtonUp="TrayItem_MouseRightButtonUp"
                                        ToolTip="{Binding Label}">
                                <Border Background="#FF0C0C0E" CornerRadius="8" Height="76" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Medium"
                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                           Margin="3,6,3,0" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                                           Margin="3,1,3,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Subtitle}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="TrayEmptyLabel" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Style="{StaticResource MutedLabel}" FontSize="12"
                           Text="Nothing here yet — screenshots you take with OverInk appear in your library." />
            </Grid>
        </Border>

        <!-- ===== Canvas ===== -->
        <Grid x:Name="CanvasArea" Background="#FF070708">
            <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="CanvasScroll_PreviewMouseWheel">
                <Grid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1" />
                    </Grid.LayoutTransform>

                    <Image x:Name="BackgroundImage" Stretch="None" />
                    <InkCanvas x:Name="InkSurface" Background="Transparent" EditingMode="Ink"
                               PreviewMouseMove="InkSurface_PreviewMouseMove" PreviewStylusMove="InkSurface_PreviewStylusMove"
                               MouseLeave="InkSurface_PointerLeft" StylusLeave="InkSurface_PointerLeft" />
                    <Canvas x:Name="ShapeCanvas" Background="Transparent" IsHitTestVisible="False" Cursor="Cross"
                            MouseLeftButtonDown="ShapeCanvas_MouseDown" MouseMove="ShapeCanvas_MouseMove"
                            MouseLeftButtonUp="ShapeCanvas_MouseUp" LostMouseCapture="ShapeCanvas_LostMouseCapture" />

                    <Canvas x:Name="CropVisualLayer" IsHitTestVisible="False">
                        <Rectangle x:Name="CropDimTop" Fill="#99000000" />
                        <Rectangle x:Name="CropDimLeft" Fill="#99000000" />
                        <Rectangle x:Name="CropDimRight" Fill="#99000000" />
                        <Rectangle x:Name="CropDimBottom" Fill="#99000000" />
                        <Rectangle x:Name="CropFrame" Stroke="#FF4C8DFF" StrokeThickness="2" Fill="Transparent" />
                    </Canvas>

                    <!-- Handles stay subtle until the pointer is over the canvas -->
                    <Canvas x:Name="CropHandleLayer" MouseMove="CropHandle_MouseMove" MouseLeftButtonUp="CropHandle_MouseUp">
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Setter Property="Opacity" Value="0.45" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=CanvasArea}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>
                        <Border x:Name="HandleTopLeft" Style="{StaticResource CropHandle}" Cursor="SizeNWSE" Tag="TopLeft"
                                MouseLeftButtonDown="CropHandle_MouseDown" MouseLeftButtonUp="CropHandle_MouseUp" />
                        <Border x:Name="HandleTop" Style="{StaticResource CropHandle}" Cursor="SizeNS" Tag="Top"
                                MouseLeftButtonDown="CropHandle_MouseDown" MouseLeftButtonUp="CropHandle_MouseUp" />
                        <Border x:Name="HandleTopRight" Style="{StaticResource CropHandle}" Cursor="SizeNESW" Tag="TopRight"
                                MouseLeftButtonDown="CropHandle_MouseDown" MouseLeftButtonUp="CropHandle_MouseUp" />
                        <Border x:Name="HandleRight" Style="{StaticResource CropHandle}" Cursor="SizeWE" Tag="Right"
                                MouseLeftButtonDown="CropHandle_MouseDown" MouseLeftButtonUp="CropHandle_MouseUp" />
                        <Border x:Name="HandleBottomRight" Style="{StaticResource CropHandle}" Cursor="SizeNWSE" Tag="BottomRight"
                                MouseLeftButtonDown="CropHandle_MouseDown" MouseLeftButtonUp="CropHandle_MouseUp" />
                        <Border x:Name="HandleBottom" Style="{StaticResource CropHandle}" Cursor="SizeNS" Tag="Bottom"
                                MouseLeftButtonDown="CropHandle_MouseDown" MouseLeftButtonUp="CropHandle_MouseUp" />
                        <Border x:Name="HandleBottomLeft" Style="{StaticResource CropHandle}" Cursor="SizeNESW" Tag="BottomLeft"
                                MouseLeftButtonDown="CropHandle_MouseDown" MouseLeftButtonUp="CropHandle_MouseUp" />
                        <Border x:Name="HandleLeft" Style="{StaticResource CropHandle}" Cursor="SizeWE" Tag="Left"
                                MouseLeftButtonDown="CropHandle_MouseDown" MouseLeftButtonUp="CropHandle_MouseUp" />
                    </Canvas>
                </Grid>
            </ScrollViewer>

            <!-- Pen cursor: lives outside the zoom transform so its ticks stay a constant size -->
            <Canvas x:Name="BrushCursorLayer" IsHitTestVisible="False" ClipToBounds="True">
                <local:BrushCursor x:Name="BrushCursorVisual" Visibility="Collapsed" />
            </Canvas>

            <!-- Shown when no capture is open -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                <Border Width="72" Height="72" CornerRadius="22" Background="#12FFFFFF" HorizontalAlignment="Center">
                    <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconImages}"
                                    Width="32" Height="32" Foreground="#FF8E8E93" />
                </Border>
                <TextBlock Text="No capture open" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Text="Take a screenshot from the OverInk toolbar, or pick one from your library below to annotate it here."
                           Style="{StaticResource RowDesc}" TextAlignment="Center" FontSize="12" />
            </StackPanel>

            <Button x:Name="ShowTrayButton" Visibility="Collapsed" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,16" Style="{StaticResource EdSecondaryButton}"
                    Click="ToggleTray_Click" ToolTip="Show library">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconImages}"
                                    Width="15" Height="15" Margin="0,0,7,0" />
                    <TextBlock Text="Show library" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </DockPanel>
</Window>
