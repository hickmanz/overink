<Window x:Class="OverInk.Editor.EditorWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="OverInk Editor"

        Width="1100"

        Height="760"

        MinWidth="640"

        MinHeight="480"

        Background="#FF101012"

        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource ShellBrush}"

                BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="0,0,0,1" Padding="12,8">

            <DockPanel LastChildFill="False">

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">

                    <ToggleButton x:Name="PenToggle" Content="Pen" Style="{StaticResource SegBase}"

                                  IsChecked="True" Click="Pen_Click" Margin="0,0,4,0" />

                    <ToggleButton x:Name="EraserToggle" Content="Eraser" Style="{StaticResource SegBase}"

                                  Click="Eraser_Click" Margin="0,0,12,0" />

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <Button Content="Crop" Style="{StaticResource IconGhost}" Click="Crop_Click" ToolTip="Draw crop region" />

                    <Button Content="Apply crop" Style="{StaticResource IconGhost}" Click="ApplyCrop_Click" Margin="0,0,12,0" />

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <ToggleButton x:Name="FitToggle" Content="Fit" Style="{StaticResource SegBase}"

                                  IsChecked="True" Click="FitZoom_Click" Margin="0,0,4,0" />

                    <Button Content="100%" Style="{StaticResource IconGhost}" Click="ActualZoom_Click" Margin="0,0,8,0" />

                    <TextBlock x:Name="ZoomLabel" Text="Fit" VerticalAlignment="Center"

                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,12,0" />

                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">

                    <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Margin="0,0,12,0"

                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" />

                    <Button x:Name="CopyButton" Content="Copy" Style="{StaticResource PrimaryButton}"

                            Click="Copy_Click" Padding="16,6" Margin="0,0,8,0" />

                    <Button Content="Save As…" Style="{StaticResource SettingsAction}" Click="Save_Click" Padding="12,6" />

                </StackPanel>

            </DockPanel>

        </Border>



        <Border x:Name="TrayPanel" DockPanel.Dock="Bottom" Background="#FF0C0C0E"

                BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="0,1,0,0" Height="132">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="12,8,12,4">

                    <TextBlock Text="Library" Foreground="{StaticResource MutedTextBrush}" FontSize="11"

                               VerticalAlignment="Center" DockPanel.Dock="Left" />

                    <Button Content="Hide tray" Style="{StaticResource IconGhost}" DockPanel.Dock="Right"

                            Click="ToggleTray_Click" FontSize="11" Padding="8,4" Height="28" />

                </DockPanel>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="8,0,8,8">

                <ListBox x:Name="LibraryList"

                         Background="Transparent" BorderThickness="0"

                         SelectionChanged="LibraryList_SelectionChanged"

                         PreviewMouseLeftButtonDown="LibraryList_PreviewMouseLeftButtonDown"

                         PreviewMouseMove="LibraryList_PreviewMouseMove">

                    <ListBox.ItemsPanel>

                        <ItemsPanelTemplate>

                            <StackPanel Orientation="Horizontal" />

                        </ItemsPanelTemplate>

                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>

                        <Style TargetType="ListBoxItem">

                            <Setter Property="Margin" Value="4,0" />

                            <Setter Property="Padding" Value="0" />

                            <Setter Property="Background" Value="Transparent" />

                            <Setter Property="BorderThickness" Value="2" />

                            <Setter Property="BorderBrush" Value="Transparent" />

                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="ListBoxItem">

                                        <Border Background="{TemplateBinding Background}"

                                                BorderBrush="{TemplateBinding BorderBrush}"

                                                BorderThickness="{TemplateBinding BorderThickness}"

                                                CornerRadius="6" Padding="2">

                                            <ContentPresenter />

                                        </Border>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                            <Style.Triggers>

                                <Trigger Property="IsSelected" Value="True">

                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />

                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">

                                    <Setter Property="Background" Value="#12FFFFFF" />

                                </Trigger>

                            </Style.Triggers>

                        </Style>

                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <StackPanel Width="100" Tag="{Binding}" MouseRightButtonUp="TrayItem_MouseRightButtonUp">

                                <Border Background="#FF1A1A1D" CornerRadius="4" Height="72" ClipToBounds="True">

                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />

                                </Border>

                                <TextBlock Text="{Binding TimeLabel}" FontSize="10"

                                           Foreground="{StaticResource MutedTextBrush}"

                                           TextTrimming="CharacterEllipsis" Margin="2,4,2,0" />

                            </StackPanel>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

                </ScrollViewer>

            </Grid>

        </Border>



        <Grid x:Name="CanvasArea" Background="#FF080809">

            <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto"

                          VerticalScrollBarVisibility="Auto"

                          PreviewMouseWheel="CanvasScroll_PreviewMouseWheel">

                <Grid x:Name="CanvasHost">

                    <Grid.LayoutTransform>

                        <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1" />

                    </Grid.LayoutTransform>

                    <Image x:Name="BackgroundImage" Stretch="None" />

                    <InkCanvas x:Name="InkSurface" Background="Transparent" EditingMode="Ink" />

                    <Canvas x:Name="CropOverlay" Visibility="Collapsed" Background="#22000000">

                        <Rectangle x:Name="CropRect"

                                   Stroke="#FF4C8DFF"

                                   StrokeThickness="2"

                                   StrokeDashArray="4 2"

                                   Fill="#334C8DFF" />

                    </Canvas>

                </Grid>

            </ScrollViewer>

            <Button x:Name="ShowTrayButton" Content="Show library tray" Visibility="Collapsed"

                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"

                    Style="{StaticResource SettingsAction}" Click="ToggleTray_Click" />

        </Grid>

    </DockPanel>

</Window>


