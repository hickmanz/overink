<Window x:Class="OverInk.Editor.EditorWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:toolbar="clr-namespace:OverInk.Toolbar"

        Title="OverInk Editor"

        Width="1200"

        Height="760"

        MinWidth="720"

        MinHeight="480"

        Background="#FF101012"

        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource ShellBrush}"

                BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="0,0,0,1" Padding="12,8">

            <DockPanel LastChildFill="False">

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">

                    <ToggleButton x:Name="PenToggle" Content="Pen" Style="{StaticResource SegBase}"

                                  IsChecked="True" Click="Pen_Click" Margin="0,0,4,0" />

                    <ToggleButton x:Name="EraserToggle" Content="Eraser" Style="{StaticResource SegBase}"

                                  Click="Eraser_Click" Margin="0,0,12,0" />

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <ToggleButton x:Name="FitToggle" Content="Fit" Style="{StaticResource SegBase}"

                                  IsChecked="True" Click="FitZoom_Click" Margin="0,0,4,0" />

                    <Button Content="100%" Style="{StaticResource IconGhost}" Click="ActualZoom_Click" Margin="0,0,8,0" />

                    <TextBlock x:Name="ZoomLabel" Text="Fit" VerticalAlignment="Center"

                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,12,0" />

                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">

                    <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Margin="0,0,12,0"

                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" />

                    <Button x:Name="CopyButton" Content="Copy" Style="{StaticResource PrimaryButton}"

                            Click="Copy_Click" Padding="16,6" Margin="0,0,8,0" />

                    <Button Content="Save As…" Style="{StaticResource SettingsAction}" Click="Save_Click" Padding="12,6" />

                </StackPanel>

            </DockPanel>

        </Border>



        <Border x:Name="ToolsPanel" DockPanel.Dock="Right" Width="236"

                Background="#FF0C0C0E" BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="1,0,0,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,12">

                <StackPanel>

                    <TextBlock Text="Pen" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" />

                    <TextBlock Text="Color and stroke for new ink" Style="{StaticResource MutedLabel}" Margin="0,2,0,10" />

                    <toolbar:ColorPickerControl x:Name="EditorColorPicker" HorizontalAlignment="Center" Margin="0,0,0,8" />

                    <TextBlock Text="Size" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,4" />

                    <Slider x:Name="PenSizeSlider" Minimum="1" Maximum="24" Value="4"

                            Style="{StaticResource StrokeSlider}" ValueChanged="PenSizeSlider_ValueChanged" />

                    <WrapPanel x:Name="PresetSwatchesPanel" Margin="0,10,0,0" />



                    <Border Height="1" Background="{StaticResource BorderBrushMuted}" Margin="0,16,0,16" />



                    <TextBlock Text="Crop" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" />

                    <TextBlock Text="Drag edge handles — crop applies when you release" Style="{StaticResource MutedLabel}"

                               TextWrapping="Wrap" Margin="0,2,0,10" />

                    <Button Content="Reset crop" Style="{StaticResource IconGhost}" Click="ResetCrop_Click"

                            HorizontalAlignment="Stretch" Padding="10,6" FontSize="11" />

                </StackPanel>

            </ScrollViewer>

        </Border>



        <Border x:Name="TrayPanel" DockPanel.Dock="Bottom" Background="#FF0C0C0E"

                BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="0,1,0,0" MinHeight="168">

            <Grid Margin="0,0,0,4">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="*" MinHeight="118" />

                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="12,10,12,6">

                    <TextBlock Text="Library" Foreground="{StaticResource MutedTextBrush}" FontSize="11"

                               VerticalAlignment="Center" DockPanel.Dock="Left" />

                    <Button Content="Hide tray" Style="{StaticResource IconGhost}" DockPanel.Dock="Right"

                            Click="ToggleTray_Click" FontSize="11" Padding="8,4" Height="28" />

                </DockPanel>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"

                              VerticalScrollBarVisibility="Disabled" Margin="8,0,8,10">

                    <ListBox x:Name="LibraryList" Background="Transparent" BorderThickness="0"

                             SelectionChanged="LibraryList_SelectionChanged"

                             PreviewMouseLeftButtonDown="LibraryList_PreviewMouseLeftButtonDown"

                             PreviewMouseMove="LibraryList_PreviewMouseMove">

                        <ListBox.ItemsPanel>

                            <ItemsPanelTemplate>

                                <StackPanel Orientation="Horizontal" />

                            </ItemsPanelTemplate>

                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>

                            <Style TargetType="ListBoxItem">

                                <Setter Property="Margin" Value="4,0" />

                                <Setter Property="Padding" Value="0" />

                                <Setter Property="Background" Value="Transparent" />

                                <Setter Property="BorderThickness" Value="2" />

                                <Setter Property="BorderBrush" Value="Transparent" />

                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                                <Setter Property="VerticalContentAlignment" Value="Top" />

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="ListBoxItem">

                                            <Border Background="{TemplateBinding Background}"

                                                    BorderBrush="{TemplateBinding BorderBrush}"

                                                    BorderThickness="{TemplateBinding BorderThickness}"

                                                    CornerRadius="6" Padding="2">

                                                <ContentPresenter />

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers>

                                    <Trigger Property="IsSelected" Value="True">

                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />

                                    </Trigger>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="#12FFFFFF" />

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <StackPanel Width="104" Tag="{Binding}" MouseRightButtonUp="TrayItem_MouseRightButtonUp">

                                    <Border Background="#FF1A1A1D" CornerRadius="4" Height="80" ClipToBounds="True">

                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />

                                    </Border>

                                    <TextBlock Text="{Binding TimeLabel}" FontSize="10"

                                               Foreground="{StaticResource MutedTextBrush}"

                                               TextTrimming="CharacterEllipsis" Margin="2,6,2,2" />

                                </StackPanel>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </ScrollViewer>

            </Grid>

        </Border>



        <Grid x:Name="CanvasArea" Background="#FF080809">

            <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto"

                          VerticalScrollBarVisibility="Auto"

                          PreviewMouseWheel="CanvasScroll_PreviewMouseWheel">

                <Grid x:Name="CanvasHost">

                    <Grid.LayoutTransform>

                        <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1" />

                    </Grid.LayoutTransform>

                    <Image x:Name="BackgroundImage" Stretch="None" />

                    <InkCanvas x:Name="InkSurface" Background="Transparent" EditingMode="Ink" />

                    <Canvas x:Name="CropVisualLayer" IsHitTestVisible="False">

                        <Rectangle x:Name="CropDimTop" Fill="#66000000" />

                        <Rectangle x:Name="CropDimLeft" Fill="#66000000" />

                        <Rectangle x:Name="CropDimRight" Fill="#66000000" />

                        <Rectangle x:Name="CropDimBottom" Fill="#66000000" />

                        <Rectangle x:Name="CropFrame" Stroke="#FF4C8DFF" StrokeThickness="2" Fill="Transparent" />

                    </Canvas>

                    <Canvas x:Name="CropHandleLayer"
                            MouseMove="CropHandle_MouseMove" MouseLeftButtonUp="CropHandle_MouseUp">

                        <Border x:Name="HandleTopLeft" Width="12" Height="12" Background="White"

                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="2"

                                Cursor="SizeNWSE" Tag="TopLeft" MouseLeftButtonDown="CropHandle_MouseDown"

                                MouseLeftButtonUp="CropHandle_MouseUp" />

                        <Border x:Name="HandleTop" Width="12" Height="12" Background="White"

                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="2"

                                Cursor="SizeNS" Tag="Top" MouseLeftButtonDown="CropHandle_MouseDown"

                                MouseLeftButtonUp="CropHandle_MouseUp" />

                        <Border x:Name="HandleTopRight" Width="12" Height="12" Background="White"

                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="2"

                                Cursor="SizeNESW" Tag="TopRight" MouseLeftButtonDown="CropHandle_MouseDown"

                                MouseLeftButtonUp="CropHandle_MouseUp" />

                        <Border x:Name="HandleRight" Width="12" Height="12" Background="White"

                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="2"

                                Cursor="SizeWE" Tag="Right" MouseLeftButtonDown="CropHandle_MouseDown"

                                MouseLeftButtonUp="CropHandle_MouseUp" />

                        <Border x:Name="HandleBottomRight" Width="12" Height="12" Background="White"

                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="2"

                                Cursor="SizeNWSE" Tag="BottomRight" MouseLeftButtonDown="CropHandle_MouseDown"

                                MouseLeftButtonUp="CropHandle_MouseUp" />

                        <Border x:Name="HandleBottom" Width="12" Height="12" Background="White"

                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="2"

                                Cursor="SizeNS" Tag="Bottom" MouseLeftButtonDown="CropHandle_MouseDown"

                                MouseLeftButtonUp="CropHandle_MouseUp" />

                        <Border x:Name="HandleBottomLeft" Width="12" Height="12" Background="White"

                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="2"

                                Cursor="SizeNESW" Tag="BottomLeft" MouseLeftButtonDown="CropHandle_MouseDown"

                                MouseLeftButtonUp="CropHandle_MouseUp" />

                        <Border x:Name="HandleLeft" Width="12" Height="12" Background="White"

                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="2"

                                Cursor="SizeWE" Tag="Left" MouseLeftButtonDown="CropHandle_MouseDown"

                                MouseLeftButtonUp="CropHandle_MouseUp" />

                    </Canvas>

                </Grid>

            </ScrollViewer>

            <Button x:Name="ShowTrayButton" Content="Show library tray" Visibility="Collapsed"

                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"

                    Style="{StaticResource SettingsAction}" Click="ToggleTray_Click" />

        </Grid>

    </DockPanel>

</Window>


