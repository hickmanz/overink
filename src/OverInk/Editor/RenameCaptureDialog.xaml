<Window x:Class="OverInk.Editor.RenameCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename capture"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF101012">
    <StackPanel Margin="20">
        <TextBlock Text="Name" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox" Width="320" Padding="8,6" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource IconGhost}" Margin="0,0,8,0" Padding="12,6" />
            <Button Content="OK" IsDefault="True" Click="Ok_Click" Style="{StaticResource PrimaryButton}" Padding="16,6" />
        </StackPanel>
    </StackPanel>
</Window>
