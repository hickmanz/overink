<Window x:Class="OverInk.Remote.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote sketch pair"
        Width="420"
        Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Scan to join this session" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" x:Name="UrlText" Margin="0,8,0,12" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
        <Image Grid.Row="2" x:Name="QrImage" Width="220" Height="220" HorizontalAlignment="Center" Margin="0,0,0,12" />
        <StackPanel Grid.Row="3">
            <TextBlock Text="Connected devices" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ListBox x:Name="ParticipantsList" Height="120" />
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#666" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Rotate join link" Click="RotateJoinLink_Click" Margin="0,0,8,0" Padding="12,6" />
            <Button Content="Revoke all paired" Click="RevokeAll_Click" Margin="0,0,8,0" Padding="12,6" />
            <Button Content="Close" Click="Close_Click" Padding="12,6" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
