<Window x:Class="OverInk.Remote.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote sketch pair"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="Scan to join this session" FontSize="18" FontWeight="SemiBold" />

        <TextBlock Text="Connect over" Margin="0,12,0,4" Foreground="#555" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="AdapterCombo" DisplayMemberPath="Label" SelectionChanged="AdapterCombo_SelectionChanged" />
            <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" Margin="8,0,0,0" Padding="10,2" />
        </Grid>
        <CheckBox x:Name="ShowAllCheck" Content="Show all adapters (disconnected, virtual)" Margin="0,6,0,0"
                  Checked="ShowAll_Changed" Unchecked="ShowAll_Changed" />
        <TextBlock x:Name="AdapterWarningText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#B45F06" Visibility="Collapsed" />

        <TextBlock x:Name="UrlText" Margin="0,12,0,8" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
        <Image x:Name="QrImage" Width="220" Height="220" HorizontalAlignment="Center" Margin="0,0,0,8" />
        <TextBlock x:Name="AltUrlText" TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,8" />

        <Border x:Name="FirewallPanel" Visibility="Collapsed" Background="#FFF4E5" BorderBrush="#E0A458" BorderThickness="1"
                CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="FirewallText" TextWrapping="Wrap" Foreground="#6B4200" />
                <Button x:Name="FixFirewallButton" Content="Fix firewall (asks for admin)" Click="FixFirewall_Click"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4" />
            </StackPanel>
        </Border>

        <Border x:Name="VpnPanel" Visibility="Collapsed" Background="#FFF4E5" BorderBrush="#E0A458" BorderThickness="1"
                CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <TextBlock x:Name="VpnText" TextWrapping="Wrap" Foreground="#6B4200" />
        </Border>

        <Border x:Name="HintPanel" Visibility="Collapsed" Background="#EEF3FB" BorderBrush="#9DB7E0" BorderThickness="1"
                CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <TextBlock x:Name="HintText" TextWrapping="Wrap" Foreground="#1F3A60" />
        </Border>

        <TextBlock Text="Connected devices" FontWeight="SemiBold" Margin="0,4,0,6" />
        <ListBox x:Name="ParticipantsList" Height="90" />
        <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#666" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Rotate join link" Click="RotateJoinLink_Click" Margin="0,0,8,0" Padding="12,6" />
            <Button Content="Revoke all paired" Click="RevokeAll_Click" Margin="0,0,8,0" Padding="12,6" />
            <Button Content="Close" Click="Close_Click" Padding="12,6" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
