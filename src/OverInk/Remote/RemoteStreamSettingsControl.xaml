<UserControl x:Class="OverInk.Remote.RemoteStreamSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="WHAT THE TABLET SEES" Style="{StaticResource SectionLabel}" />
        <UniformGrid Columns="3">
            <Button x:Name="TargetFollowButton" Content="Toolbar screen" Click="TargetFollow_Click"
                    Style="{StaticResource PresetButton}" ToolTip="The monitor the toolbar is on" />
            <Button x:Name="TargetMonitorButton" Content="One screen" Click="TargetMonitor_Click"
                    Style="{StaticResource PresetButton}" ToolTip="A monitor you choose" />
            <Button x:Name="TargetAllButton" Content="All screens" Click="TargetAll_Click"
                    Style="{StaticResource PresetButton}" Margin="0" ToolTip="Every monitor as one wide picture" />
        </UniformGrid>
        <StackPanel x:Name="MonitorListPanel" Margin="0,8,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="TargetHintText" Style="{StaticResource RowDesc}" TextWrapping="Wrap" Margin="0,8,0,16" />

        <TextBlock Text="STREAM QUALITY" Style="{StaticResource SectionLabel}" />

        <!-- Summary card -->
        <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource BorderBrushMuted}"
                BorderThickness="1" CornerRadius="9" Padding="12,10">
            <StackPanel>
                <TextBlock x:Name="StreamText" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="MonitorText" Style="{StaticResource RowDesc}" Margin="0,3,0,0" />
                <TextBlock x:Name="GuidanceText" Style="{StaticResource RowDesc}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Presets -->
        <TextBlock Text="Preset" Style="{StaticResource RowTitle}" Margin="0,14,0,8" />
        <UniformGrid Columns="4">
            <Button Content="Eco" Click="PresetEco_Click" Style="{StaticResource PresetButton}" />
            <Button Content="Balanced" Click="PresetBalanced_Click" Style="{StaticResource PresetButton}" />
            <Button Content="Sharp" Click="PresetSharp_Click" Style="{StaticResource PresetButton}" />
            <Button Content="Native" Click="PresetNative_Click" Style="{StaticResource PresetButton}" Margin="0" />
        </UniformGrid>

        <!-- Fine tuning -->
        <Grid Margin="0,16,0,6">
            <TextBlock Text="Max long edge" Style="{StaticResource RowTitle}" />
            <TextBlock x:Name="MaxEdgeValue" HorizontalAlignment="Right" FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}" />
        </Grid>
        <Slider x:Name="MaxEdgeSlider" Style="{StaticResource ThemedSlider}" Minimum="960" Maximum="7680" TickFrequency="160"
                IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" />

        <Grid Margin="0,14,0,6">
            <TextBlock Text="Frame rate" Style="{StaticResource RowTitle}" />
            <TextBlock x:Name="FpsValue" HorizontalAlignment="Right" FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}" />
        </Grid>
        <Slider x:Name="FpsSlider" Style="{StaticResource ThemedSlider}" Minimum="3" Maximum="20" Value="10" TickFrequency="1"
                IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" />

        <Grid Margin="0,14,0,6">
            <TextBlock Text="JPEG quality" Style="{StaticResource RowTitle}" />
            <TextBlock x:Name="QualityValue" HorizontalAlignment="Right" FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}" />
        </Grid>
        <Slider x:Name="QualitySlider" Style="{StaticResource ThemedSlider}" Minimum="45" Maximum="95" Value="95" TickFrequency="5"
                IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" />

        <TextBlock x:Name="BandwidthText" Style="{StaticResource RowDesc}" Margin="0,14,0,0" />
        <TextBlock Style="{StaticResource RowDesc}" Margin="0,2,0,0" Text="Changes apply immediately to connected devices." />
    </StackPanel>
</UserControl>
