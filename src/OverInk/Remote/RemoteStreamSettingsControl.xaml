<UserControl x:Class="OverInk.Remote.RemoteStreamSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="420">
    <StackPanel>
        <TextBlock Text="Remote stream quality" Foreground="#EEE" FontSize="12" FontWeight="SemiBold" />
        <TextBlock x:Name="MonitorText" Margin="0,6,0,2" TextWrapping="Wrap" FontSize="11" Foreground="#CCC" />
        <TextBlock x:Name="StreamText" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="11" Foreground="#FFF" />
        <TextBlock x:Name="GuidanceText" Margin="0,4,0,10" TextWrapping="Wrap" Foreground="#AAA" FontSize="11" />

        <WrapPanel Margin="0,0,0,10">
            <Button Content="Eco" Click="PresetEco_Click" Padding="8,4" Margin="0,0,6,6" />
            <Button Content="Balanced" Click="PresetBalanced_Click" Padding="8,4" Margin="0,0,6,6" />
            <Button Content="Sharp" Click="PresetSharp_Click" Padding="8,4" Margin="0,0,6,6" />
            <Button Content="Native" Click="PresetNative_Click" Padding="8,4" Margin="0,0,6,6" />
        </WrapPanel>

        <TextBlock x:Name="MaxEdgeLabel" FontSize="11" Foreground="#CCC" />
        <Slider x:Name="MaxEdgeSlider" Minimum="960" Maximum="7680" Value="2560" TickFrequency="160"
                IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" Margin="0,2,0,8" />
        <TextBlock x:Name="FpsLabel" FontSize="11" Foreground="#CCC" />
        <Slider x:Name="FpsSlider" Minimum="3" Maximum="20" Value="10" TickFrequency="1"
                IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" Margin="0,2,0,8" />
        <TextBlock x:Name="QualityLabel" FontSize="11" Foreground="#CCC" />
        <Slider x:Name="QualitySlider" Minimum="45" Maximum="95" Value="78" TickFrequency="5"
                IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" Margin="0,2,0,6" />
        <TextBlock x:Name="BandwidthText" FontSize="10" Foreground="#888" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,0" Text="Updates apply immediately on connected remote clients." FontSize="10" Foreground="#666" />
    </StackPanel>
</UserControl>
