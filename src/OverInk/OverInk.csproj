<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Resource Include="Themes\MinimalDark.xaml" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>OverInk</RootNamespace>
    <AssemblyName>OverInk</AssemblyName>
    <Product>OverInk</Product>
    <AssemblyTitle>OverInk</AssemblyTitle>
    <Description>Live screen annotation overlay for Windows</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Remote\wwwroot\**\*" />
  </ItemGroup>

</Project>
