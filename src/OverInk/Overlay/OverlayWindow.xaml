<Window x:Class="OverInk.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OverInk Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="True">
    <Grid Background="#01000000">
        <!-- Optional white veil under the ink so sketches stand out; also visible in the remote stream. -->
        <Rectangle x:Name="ScreenVeil"
                   Fill="White"
                   Opacity="0"
                   IsHitTestVisible="False"
                   Visibility="Collapsed" />
        <InkCanvas x:Name="InkSurface"
                   Background="Transparent"
                   EditingMode="Ink"
                   Focusable="True"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   UseCustomCursor="False" />
        <Canvas x:Name="ShapeLayer"
                Background="Transparent"
                IsHitTestVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        <Rectangle x:Name="CaptureRegionOutline"
                   Stroke="#994C8DFF"
                   StrokeThickness="2"
                   StrokeDashArray="6 4"
                   Fill="Transparent"
                   IsHitTestVisible="False"
                   Visibility="Collapsed" />
    </Grid>
</Window>
