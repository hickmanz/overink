<Window x:Class="OverInk.Overlay.RegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross">
    <Canvas x:Name="RootCanvas" Background="Transparent">
        <Rectangle x:Name="DimTop" Fill="#99000000" IsHitTestVisible="False" />
        <Rectangle x:Name="DimLeft" Fill="#99000000" IsHitTestVisible="False" />
        <Rectangle x:Name="DimRight" Fill="#99000000" IsHitTestVisible="False" />
        <Rectangle x:Name="DimBottom" Fill="#99000000" IsHitTestVisible="False" />
        <!-- Alpha 1 (not 0): fully transparent pixels of a layered window let clicks fall through to the app below. -->
        <Rectangle x:Name="SelectionFill" Stroke="#FF4C8DFF" StrokeThickness="2"
                   Fill="#01000000" Visibility="Collapsed" IsHitTestVisible="False" />
        <Border x:Name="SizeBadge" Background="#E6111114" CornerRadius="6" Padding="8,3"
                BorderBrush="#33FFFFFF" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
        </Border>
        <Border x:Name="HintBar" Background="#DD111114" CornerRadius="8" Padding="14,8"
                BorderBrush="#44FFFFFF" BorderThickness="1" IsHitTestVisible="False">
            <TextBlock x:Name="HintText" Text="Drag to select region · Esc cancel" Foreground="White" FontSize="13" />
        </Border>
    </Canvas>
</Window>
