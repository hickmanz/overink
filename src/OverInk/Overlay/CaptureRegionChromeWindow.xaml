<Window x:Class="OverInk.Overlay.CaptureRegionChromeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height">
    <Border Background="#F0111218" BorderBrush="#FF4C8DFF" BorderThickness="1"
            CornerRadius="8" Padding="10,6" MinWidth="220">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Remote capture region" Foreground="White" FontWeight="SemiBold" FontSize="12"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Adjust" Click="Adjust_Click" Margin="8,0,0,0" Padding="10,4"
                    Background="#FF2A2A30" Foreground="White" BorderThickness="0" Cursor="Hand" />
            <Button Grid.Column="2" Content="Clear" Click="Clear_Click" Margin="6,0,0,0" Padding="10,4"
                    Background="#FF3A2020" Foreground="#FFE57373" BorderThickness="0" Cursor="Hand" />
        </Grid>
    </Border>
</Window>
