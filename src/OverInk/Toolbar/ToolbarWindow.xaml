<Window x:Class="OverInk.Toolbar.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:remote="clr-namespace:OverInk.Remote"
        xmlns:toolbar="clr-namespace:OverInk.Toolbar"
        Title="OverInk"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Style="{StaticResource ToolbarShadowHost}" Margin="10">
        <Border Style="{StaticResource ToolbarShell}">
            <StackPanel>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Grid Width="22" Height="22" Margin="0,0,2,0">
                            <Image x:Name="BrandLogo" Width="22" Height="22"
                                   RenderOptions.BitmapScalingMode="HighQuality" ToolTip="OverInk" />
                            <Ellipse x:Name="RemoteDot" Width="8" Height="8" Fill="#FF43A047"
                                     VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-1,-1,0"
                                     Visibility="Collapsed" ToolTip="Remote client connected" />
                        </Grid>
                    <!-- Drag -->
                    <Border Width="22" Height="36" CornerRadius="8" Background="Transparent" Cursor="SizeAll"
                            VerticalAlignment="Center"
                            MouseLeftButtonDown="DragBar_MouseDown" MouseMove="DragBar_MouseMove" MouseLeftButtonUp="DragBar_MouseLeftButtonUp">
                        <Canvas Width="10" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Canvas.Left="0" Canvas.Top="0" Width="2.5" Height="2.5" Fill="#66FFFFFF" />
                            <Ellipse Canvas.Left="4" Canvas.Top="0" Width="2.5" Height="2.5" Fill="#66FFFFFF" />
                            <Ellipse Canvas.Left="0" Canvas.Top="5" Width="2.5" Height="2.5" Fill="#66FFFFFF" />
                            <Ellipse Canvas.Left="4" Canvas.Top="5" Width="2.5" Height="2.5" Fill="#66FFFFFF" />
                            <Ellipse Canvas.Left="0" Canvas.Top="10" Width="2.5" Height="2.5" Fill="#66FFFFFF" />
                            <Ellipse Canvas.Left="4" Canvas.Top="10" Width="2.5" Height="2.5" Fill="#66FFFFFF" />
                        </Canvas>
                    </Border>
                    </StackPanel>

                    <!-- Draw on/off -->
                    <ToggleButton x:Name="DrawToggle" Grid.Column="1" Style="{StaticResource DrawModeToggle}"
                                  Content="Pass-through" IsChecked="False" Click="DrawToggle_Click" Margin="0,0,6,0"
                                  ToolTip="Pass-through — clicks go to apps. Turn on to draw on screen (Esc turns off)." />

                    <Border Grid.Column="2" Style="{StaticResource ToolbarDivider}" />

                    <!-- Tools -->
                    <Border Grid.Column="3" Background="{StaticResource WellBrush}" CornerRadius="10" Padding="3,2"
                            VerticalAlignment="Center" ClipToBounds="True" Margin="0,0,6,0">
                        <StackPanel x:Name="ToolPanel" Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource IconTool}" ToolTip="Pen" Click="ToolButton_Click" Tag="Pen">
                                <Path Data="M3,14 C3,5 12,3 13,8 L9,10 L9,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource IconTool}" ToolTip="Line" Click="ToolButton_Click" Tag="Line">
                                <Path Data="M3,13 L13,4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource IconTool}" ToolTip="Arrow" Click="ToolButton_Click" Tag="Arrow">
                                <Path Data="M3,13 L12,5 M12,5 L8,5 M12,5 L12,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource IconTool}" ToolTip="Rectangle" Click="ToolButton_Click" Tag="Rectangle">
                                <Rectangle Width="12" Height="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" RadiusX="1" RadiusY="1" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource IconTool}" ToolTip="Ellipse" Click="ToolButton_Click" Tag="Ellipse">
                                <Ellipse Width="12" Height="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource IconTool}" ToolTip="Eraser" Click="ToolButton_Click" Tag="Eraser">
                                <Path Data="M4,12 L9,7 L13,11 L8,16 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6" Fill="#33FFFFFF" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource ToolbarDivider}" />

                    <!-- Color + width + actions (single group so nothing gets squeezed off) -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                        <ToggleButton x:Name="CustomColorButton" Style="{StaticResource ColorWheelButton}"
                                      Click="CustomColorButton_Click" />
                        <Popup x:Name="ColorPickerPopup" PlacementTarget="{Binding ElementName=CustomColorButton}"
                               Placement="Top" StaysOpen="False" AllowsTransparency="True">
                            <toolbar:ColorPickerControl x:Name="ColorPicker" ColorChanged="ColorPicker_ColorChanged" />
                        </Popup>
                        <Slider x:Name="ThicknessSlider" Style="{StaticResource StrokeSlider}" Minimum="1" Maximum="20" Value="4"
                                ToolTip="Stroke width" ValueChanged="ThicknessSlider_ValueChanged" />
                        <Border Style="{StaticResource ToolbarDivider}" />
                        <Button Style="{StaticResource IconGhost}" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click">
                            <Path Data="M8,4 L4,8 L8,12 M4,8 H11 A4,4 0 1 1 7,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource IconGhost}" ToolTip="Redo" Click="Redo_Click">
                            <Path Data="M8,4 L12,8 L8,12 M12,8 H5 A4,4 0 1 0 9,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource IconGhost}" ToolTip="Clear all" Click="Clear_Click">
                            <Path Data="M5,5 L11,11 M11,5 L5,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                        <ToggleButton x:Name="SetRegionButton" Style="{StaticResource SegBase}" Content="Set region"
                                        Click="SetRegion_Click" MinWidth="88" Margin="4,0,0,0"
                                        ToolTip="Choose a screen area for the remote stream (full screen if cleared)" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Capture" Click="Capture_Click" ToolTip="Save screenshot with ink" />
                        <Button Style="{StaticResource SettingsButton}" Content="⚙" ToolTip="Settings (shortcut, remote server, stream)" Click="SettingsButton_Click" />
                        <Button Style="{StaticResource IconGhost}" ToolTip="Hide toolbar" Click="Hide_Click">
                            <Path Data="M4,8 H12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="StatusText" Style="{StaticResource MutedLabel}" TextWrapping="Wrap"
                           Margin="4,6,4,0" Foreground="#FFE57373" Visibility="Collapsed" />

                <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="#FF161618"
                        BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="1"
                        CornerRadius="10" Padding="12,10" Margin="0,8,0,0" ClipToBounds="True" MaxWidth="520">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Global shortcut" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Toggle draw on/off from anywhere" Style="{StaticResource MutedLabel}" Margin="0,2,0,6" />
                                <TextBlock x:Name="HotkeyDisplayText" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="13" />
                                <TextBlock x:Name="HotkeyHintText" Style="{StaticResource MutedLabel}" Margin="0,6,0,0"
                                           Text="Esc turns draw off · Ctrl+Z undo while draw is on" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="RecordHotkeyButton" Style="{StaticResource SettingsAction}" Content="Change shortcut" Click="RecordHotkeyButton_Click" />
                                <Button Style="{StaticResource SettingsAction}" Content="Reset default" Click="ResetHotkeyButton_Click" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="HideToolbarWhenNotDrawingCheck" Margin="0,12,0,0"
                                  Content="Hide toolbar when not drawing"
                                  Foreground="{StaticResource TextBrush}" FontSize="12"
                                  Checked="HideToolbarWhenNotDrawing_Changed" Unchecked="HideToolbarWhenNotDrawing_Changed"
                                  ToolTip="Pass-through hides the toolbar until you turn draw mode on (shortcut still works)" />

                        <Border Height="1" Background="{StaticResource BorderBrushMuted}" Margin="0,14,0,14" />

                        <TextBlock Text="Remote sketching server" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Stream this screen to paired tablets/phones on your LAN" Style="{StaticResource MutedLabel}" Margin="0,2,0,8" />
                        <CheckBox x:Name="RemoteServerCheck" Content="Enable remote sketching server"
                                  Foreground="{StaticResource TextBrush}" FontSize="12"
                                  Checked="RemoteServerCheck_Changed" Unchecked="RemoteServerCheck_Changed" />

                        <remote:RemoteStreamSettingsControl x:Name="StreamSettings" Margin="0,12,0,0" />
                        <Button Content="Remote sketch pair…" Click="PairRemote_Click" Margin="0,10,0,0" Padding="10,6"
                                HorizontalAlignment="Left" Style="{StaticResource SettingsAction}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Border>
</Window>
