<Window x:Class="OverInk.Toolbar.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:remote="clr-namespace:OverInk.Remote"
        xmlns:toolbar="clr-namespace:OverInk.Toolbar"
        Title="OverInk"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Border Style="{StaticResource ToolbarShadowHost}" Margin="10">
        <Border Style="{StaticResource ToolbarShell}">
            <StackPanel x:Name="RootStack">
                <StackPanel x:Name="DockRow" Orientation="Horizontal" VerticalAlignment="Top">
                    <StackPanel x:Name="BrandGroup" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                        <Grid Width="22" Height="22" Margin="0,0,2,0">
                            <Image x:Name="BrandLogo" Width="22" Height="22"
                                   RenderOptions.BitmapScalingMode="HighQuality" ToolTip="OverInk" />
                            <Ellipse x:Name="RemoteDot" Width="8" Height="8" Fill="#FF43A047"
                                     VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-1,-1,0"
                                     Visibility="Collapsed" ToolTip="Remote client connected" />
                        </Grid>
                    <!-- Drag -->
                    <Border x:Name="DragGrip" Width="24" Height="34" CornerRadius="10" Background="Transparent" Cursor="SizeAll"
                            VerticalAlignment="Center" ToolTip="Drag to move · double-click to flip horizontal / vertical"
                            MouseLeftButtonDown="DragBar_MouseDown" MouseMove="DragBar_MouseMove" MouseLeftButtonUp="DragBar_MouseLeftButtonUp">
                        <ContentControl x:Name="GripIcon" Style="{StaticResource LucideIcon}" Tag="{StaticResource IconGrip}"
                                        Width="18" Height="18" Foreground="#66FFFFFF"
                                        RenderTransformOrigin="0.5,0.5"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    </StackPanel>

                    <!-- Draw on/off -->
                    <ToggleButton x:Name="DrawToggle" Style="{StaticResource DrawPill}"
                                  Content="Draw mode" IsChecked="False" Click="DrawToggle_Click"
                                  ToolTip="Turn on to sketch on screen (Esc turns off)" />

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <!-- Tools -->
                    <Border VerticalAlignment="Center">
                        <StackPanel x:Name="ToolPanel" Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource DockToolToggle}" ToolTip="Pen" Click="ToolButton_Click" Tag="Pen">
                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconPen}" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource DockToolToggle}" ToolTip="Line" Click="ToolButton_Click" Tag="Line">
                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconLine}" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource DockToolToggle}" ToolTip="Arrow" Click="ToolButton_Click" Tag="Arrow">
                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconArrow}" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource DockToolToggle}" ToolTip="Rectangle" Click="ToolButton_Click" Tag="Rectangle">
                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconRectangle}" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource DockToolToggle}" ToolTip="Ellipse" Click="ToolButton_Click" Tag="Ellipse">
                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconEllipse}" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource DockToolToggle}" ToolTip="Eraser" Click="ToolButton_Click" Tag="Eraser">
                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconEraser}" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <!-- Compact tools: one button for the current drawing tool (tap again for the list) + the eraser -->
                    <StackPanel x:Name="ToolMenuGroup" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <ToggleButton x:Name="ShapeToolButton" Style="{StaticResource DockToolToggle}"
                                      Click="ShapeToolButton_Click">
                            <Grid Width="34" Height="34">
                                <ContentControl x:Name="ShapeToolIcon" Style="{StaticResource LucideIcon}"
                                                Tag="{StaticResource IconPen}" />
                                <!-- Corner notch: this button opens a list -->
                                <Path Data="M0,5 L5,5 L5,0 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Margin="0,0,5,5" IsHitTestVisible="False" />
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="EraserQuickButton" Style="{StaticResource DockToolToggle}" ToolTip="Eraser"
                                      Click="ToolButton_Click" Tag="Eraser">
                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconEraser}" />
                        </ToggleButton>
                        <Popup x:Name="ToolPopup" PlacementTarget="{Binding ElementName=ShapeToolButton}"
                               Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               Closed="ToolPopup_Closed">
                            <Border Style="{StaticResource PopoverCard}" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="DRAW WITH" Style="{StaticResource SectionLabel}" Margin="4,2,0,8" />
                                    <StackPanel x:Name="ToolOptionsPanel" Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource DockToolToggle}" ToolTip="Pen" Click="ToolButton_Click" Tag="Pen">
                                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconPen}" />
                                        </ToggleButton>
                                        <ToggleButton Style="{StaticResource DockToolToggle}" ToolTip="Line" Click="ToolButton_Click" Tag="Line">
                                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconLine}" />
                                        </ToggleButton>
                                        <ToggleButton Style="{StaticResource DockToolToggle}" ToolTip="Arrow" Click="ToolButton_Click" Tag="Arrow">
                                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconArrow}" />
                                        </ToggleButton>
                                        <ToggleButton Style="{StaticResource DockToolToggle}" ToolTip="Rectangle" Click="ToolButton_Click" Tag="Rectangle">
                                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconRectangle}" />
                                        </ToggleButton>
                                        <ToggleButton Style="{StaticResource DockToolToggle}" ToolTip="Ellipse" Click="ToolButton_Click" Tag="Ellipse">
                                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconEllipse}" />
                                        </ToggleButton>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <!-- Color + stroke width: compact buttons that open popovers (same as the iPad dock) -->
                    <StackPanel x:Name="ColorGroup" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="ColorButton" ToolTip="Color"
                                      IsChecked="{Binding IsOpen, ElementName=ColorPickerPopup, Mode=TwoWay}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource DockPopupToggle}">
                                    <Style.Triggers>
                                        <!-- While open, let the click fall through so the popup closes instead of instantly reopening -->
                                        <DataTrigger Binding="{Binding IsOpen, ElementName=ColorPickerPopup}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <Ellipse x:Name="ColorDot" Width="20" Height="20" Fill="#FFE53935"
                                     Stroke="#F2FFFFFF" StrokeThickness="2" />
                        </ToggleButton>
                        <Popup x:Name="ColorPickerPopup" PlacementTarget="{Binding ElementName=ColorButton}"
                               Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               Opened="ColorPopup_Opened" Closed="ColorPopup_Closed">
                            <Border Style="{StaticResource PopoverCard}">
                                <!-- 7 swatches x 36 (30 + 3px margin each side): narrower and the selected halo is clipped -->
                                <StackPanel Width="252">
                                    <TextBlock Text="COLOR" Style="{StaticResource SectionLabel}" />
                                    <UniformGrid x:Name="SwatchPanel" Columns="7" />
                                    <Border Height="1" Background="{StaticResource BorderBrushMuted}" Margin="0,10" />
                                    <!-- Transparent background so the whole row (not just the wheel) takes the click -->
                                    <Grid Background="Transparent" Cursor="Hand" MinHeight="32"
                                          MouseLeftButtonUp="CustomColorRow_Click">
                                        <ToggleButton x:Name="CustomColorButton" Style="{StaticResource ColorWheelButton}"
                                                      HorizontalAlignment="Left" Margin="4,0,0,0"
                                                      Click="CustomColorButton_Click" />
                                        <TextBlock Text="Custom color" Style="{StaticResource RowTitle}"
                                                   Margin="38,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <toolbar:ColorPickerControl x:Name="ColorPicker" Visibility="Collapsed" Margin="0,12,0,0"
                                                                HorizontalAlignment="Center" ColorChanged="ColorPicker_ColorChanged"
                                                                SaveRequested="ColorPicker_SaveRequested" />
                                </StackPanel>
                            </Border>
                        </Popup>

                        <ToggleButton x:Name="StrokeButton" ToolTip="Stroke width"
                                      IsChecked="{Binding IsOpen, ElementName=StrokePopup, Mode=TwoWay}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource DockPopupToggle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOpen, ElementName=StrokePopup}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <Viewbox Width="22" Height="19" Stretch="Uniform">
                                <Canvas Width="28" Height="24">
                                    <!-- Thickness follows the stroke-width setting (set from code-behind) -->
                                    <Path x:Name="StrokeIconPath" Data="{StaticResource StrokeCurve}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </ToggleButton>
                        <Popup x:Name="StrokePopup" PlacementTarget="{Binding ElementName=StrokeButton}"
                               Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Style="{StaticResource PopoverCard}">
                                <StackPanel Width="236">
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="STROKE WIDTH" Style="{StaticResource SectionLabel}" Margin="0" />
                                        <TextBlock x:Name="ThicknessValue" HorizontalAlignment="Right" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="44" CornerRadius="12" Background="#12FFFFFF">
                                            <Viewbox Width="34" Height="29" Stretch="Uniform">
                                                <Canvas Width="28" Height="24">
                                                    <Path x:Name="StrokePreviewPath" Data="{StaticResource StrokeCurve}"
                                                          Stroke="#FFE53935" StrokeThickness="3"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <Slider x:Name="ThicknessSlider" Grid.Column="1" Style="{StaticResource ThemedSlider}"
                                                Margin="14,0,0,0" VerticalAlignment="Center"
                                                Minimum="1" Maximum="20" Value="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="ThicknessSlider_ValueChanged" />
                                    </Grid>
                                    <Grid Margin="0,14,0,0"
                                          ToolTip="On: pressing harder draws a thicker line. Off: every stroke uses the width above.">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Pressure sensitivity" Style="{StaticResource RowTitle}" />
                                            <TextBlock Text="Off = constant width" Style="{StaticResource RowDesc}" />
                                        </StackPanel>
                                        <CheckBox x:Name="PressureCheck" Grid.Column="1" Margin="12,0,0,0"
                                                  Style="{StaticResource SwitchCheckBox}"
                                                  AutomationProperties.Name="Pressure sensitivity"
                                                  Checked="PressureCheck_Changed" Unchecked="PressureCheck_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Screen veil: a white wash over the screen, under the ink, so sketches stand out -->
                        <ToggleButton x:Name="VeilButton" ToolTip="Screen veil"
                                      IsChecked="{Binding IsOpen, ElementName=VeilPopup, Mode=TwoWay}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource DockPopupToggle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOpen, ElementName=VeilPopup}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconContrast}" />
                        </ToggleButton>
                        <Popup x:Name="VeilPopup" PlacementTarget="{Binding ElementName=VeilButton}"
                               Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Style="{StaticResource PopoverCard}">
                                <StackPanel Width="236">
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="SCREEN VEIL" Style="{StaticResource SectionLabel}" Margin="0" />
                                        <TextBlock x:Name="VeilValue" HorizontalAlignment="Right" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    </Grid>
                                    <Slider x:Name="VeilSlider" Style="{StaticResource ThemedSlider}"
                                            Minimum="0" Maximum="60" Value="0" TickFrequency="5" IsSnapToTickEnabled="True"
                                            ValueChanged="VeilSlider_ValueChanged" />
                                    <TextBlock Style="{StaticResource RowDesc}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Text="Washes the screen toward white, under your ink, so sketches stand out. Also applies to the tablet stream." />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <StackPanel x:Name="UndoGroup" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource DockButton}" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click">
                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconUndo}" />
                        </Button>
                        <Button Style="{StaticResource DockButton}" ToolTip="Redo" Click="Redo_Click">
                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconRedo}" />
                        </Button>
                        <Button Style="{StaticResource DockButton}" ToolTip="Clear all" Click="Clear_Click">
                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconTrash}" />
                        </Button>
                    </StackPanel>

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <StackPanel x:Name="CaptureGroup" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="SetRegionButton" Style="{StaticResource DockToolToggle}"
                                      Click="SetRegion_Click"
                                      ToolTip="Choose a screen area for the remote stream (full screen if cleared)">
                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconScan}" />
                        </ToggleButton>
                        <Border x:Name="CaptureSplit" Margin="4,0,0,0" CornerRadius="11" Background="{StaticResource AccentBrush}"
                                ToolTip="{Binding ElementName=CaptureMainButton, Path=ToolTip}">
                            <StackPanel x:Name="CaptureSplitPanel" Orientation="Horizontal">
                                <Button x:Name="CaptureMainButton" Style="{StaticResource CaptureSplitMain}" Height="34"
                                        Click="Capture_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconCamera}"
                                                        Width="16" Height="16" />
                                        <TextBlock x:Name="CaptureLabel" Text="Capture" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border x:Name="CaptureSplitDivider" Width="1" Background="#33FFFFFF" Margin="0,7" />
                                <Button x:Name="CaptureMenuButton" Style="{StaticResource CaptureSplitArrow}" Height="34"
                                        Click="CaptureMenuButton_Click" ToolTip="Capture options">
                                    <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconChevronDown}"
                                                    Width="14" Height="14" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- Capture options -->
                        <Popup x:Name="CapturePopup" PlacementTarget="{Binding ElementName=CaptureSplit}"
                               Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               Closed="CapturePopup_Closed">
                            <Border Style="{StaticResource PopoverCard}" Padding="8">
                                <StackPanel Width="296">
                                    <TextBlock Text="CAPTURE" Style="{StaticResource SectionLabel}" Margin="8,6,0,8" />

                                    <Button Style="{StaticResource MenuRow}" Tag="Auto" Click="CaptureMode_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="10" Background="#14FFFFFF" Margin="0,0,12,0">
                                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconScan}"
                                                                Foreground="#FFE0E0E6" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Auto" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="Active region if you set one, otherwise the full screen"
                                                           Style="{StaticResource RowDesc}" />
                                            </StackPanel>
                                            <ContentControl x:Name="CaptureAutoCheck" Grid.Column="2" Style="{StaticResource LucideIcon}"
                                                            Tag="{StaticResource IconCheck}" Width="16" Height="16" Margin="8,0,2,0"
                                                            Foreground="{StaticResource AccentBrush}" />
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource MenuRow}" Tag="FullScreen" Click="CaptureMode_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="10" Background="#14FFFFFF" Margin="0,0,12,0">
                                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconMonitor}"
                                                                Foreground="#FFE0E0E6" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Full screen" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="Always the whole display" Style="{StaticResource RowDesc}" />
                                            </StackPanel>
                                            <ContentControl x:Name="CaptureFullCheck" Grid.Column="2" Style="{StaticResource LucideIcon}"
                                                            Tag="{StaticResource IconCheck}" Width="16" Height="16" Margin="8,0,2,0"
                                                            Foreground="{StaticResource AccentBrush}" />
                                        </Grid>
                                    </Button>

                                    <Border Height="1" Background="{StaticResource BorderBrushMuted}" Margin="8,6" />

                                    <Button Style="{StaticResource MenuRow}" Click="CapturePickRegion_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="10" Background="#144C8DFF" Margin="0,0,12,0">
                                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconCrop}"
                                                                Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Select region…" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="Drag out an area for this capture" Style="{StaticResource RowDesc}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Keycap}" Margin="8,0,2,0" Padding="7,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="CapturePopupHotkeyText" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <Border Height="1" Background="{StaticResource BorderBrushMuted}" Margin="8,6" />

                                    <Grid Margin="8,6,8,4" ToolTip="Puts each capture on the clipboard (image and file) the moment it is taken">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Copy to clipboard" Style="{StaticResource RowTitle}" />
                                            <TextBlock Text="Automatically after every capture" Style="{StaticResource RowDesc}" />
                                        </StackPanel>
                                        <CheckBox x:Name="CapturePopupAutoCopyCheck" Grid.Column="1" Margin="12,0,0,0"
                                                  Style="{StaticResource SwitchCheckBox}"
                                                  AutomationProperties.Name="Copy captures to the clipboard automatically"
                                                  Checked="AutoCopy_Changed" Unchecked="AutoCopy_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>                        <Button x:Name="EditorButton" Style="{StaticResource DockButton}" Margin="5,1,1,1"
                                ToolTip="Open editor / capture library" Click="OpenEditor_Click">
                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconImages}" />
                        </Button>
                    </StackPanel>

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <StackPanel x:Name="SettingsGroup" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource DockButton}" ToolTip="Settings (shortcut, remote server, stream)" Click="SettingsButton_Click">
                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconSettings}" />
                        </Button>
                        <Button Style="{StaticResource DockButton}" ToolTip="Hide toolbar" Click="Hide_Click">
                            <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconMinus}" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="StatusText" Style="{StaticResource MutedLabel}" TextWrapping="Wrap"
                           Margin="4,6,4,0" Foreground="#FFE57373" Visibility="Collapsed" />

                <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="1"
                        CornerRadius="12" Padding="18,14,18,18" Margin="0,8,0,0" ClipToBounds="True" MaxWidth="780">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Settings" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource CloseGhost}" HorizontalAlignment="Right" ToolTip="Close settings"
                                    Click="SettingsButton_Click">
                                <ContentControl Style="{StaticResource LucideIcon}" Tag="{StaticResource IconX}" Width="16" Height="16" />
                            </Button>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="300" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="300" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: general + remote server -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Global shortcut" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Toggle draw on/off from anywhere" Style="{StaticResource RowDesc}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Keycap}" Margin="12,0,0,0">
                                        <TextBlock x:Name="HotkeyDisplayText" Foreground="{StaticResource TextBrush}"
                                                   FontFamily="Consolas" FontSize="12.5" />
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="RecordHotkeyButton" Style="{StaticResource SettingsAction}" Content="Change"
                                            MinWidth="76" Click="RecordHotkeyButton_Click" />
                                    <Button Style="{StaticResource SettingsAction}" Content="Reset" MinWidth="64"
                                            Click="ResetHotkeyButton_Click" />
                                </StackPanel>
                                <TextBlock x:Name="HotkeyHintText" Style="{StaticResource RowDesc}" Margin="0,8,0,0"
                                           Text="Esc turns draw off · Ctrl+Z undo while draw is on" />

                                <Border Height="1" Background="{StaticResource BorderBrushMuted}" Margin="0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Region capture shortcut" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Drag out an area and capture it from anywhere" Style="{StaticResource RowDesc}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Keycap}" Margin="12,0,0,0">
                                        <TextBlock x:Name="CaptureHotkeyDisplayText" Foreground="{StaticResource TextBrush}"
                                                   FontFamily="Consolas" FontSize="12.5" />
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="RecordCaptureHotkeyButton" Style="{StaticResource SettingsAction}" Content="Set shortcut"
                                            MinWidth="76" Click="RecordCaptureHotkeyButton_Click" />
                                    <Button x:Name="ClearCaptureHotkeyButton" Style="{StaticResource SettingsAction}" Content="Clear"
                                            MinWidth="64" Click="ClearCaptureHotkeyButton_Click" />
                                </StackPanel>
                                <TextBlock x:Name="CaptureHotkeyHintText" Style="{StaticResource RowDesc}" Margin="0,8,0,0"
                                           Text="Ctrl/Alt/Shift/Win + a key, or Print Screen / an F-key on its own" />

                                <Border Height="1" Background="{StaticResource BorderBrushMuted}" Margin="0,14" />

                                <Grid ToolTip="Puts each capture on the clipboard (image and file) the moment it is taken">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Copy captures to clipboard" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Automatically after every capture on this PC" Style="{StaticResource RowDesc}" />
                                    </StackPanel>
                                    <CheckBox x:Name="AutoCopyCheck" Grid.Column="1" Margin="12,0,0,0"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="Copy captures to the clipboard automatically"
                                              Checked="AutoCopy_Changed" Unchecked="AutoCopy_Changed" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderBrushMuted}" Margin="0,14" />

                                <Grid ToolTip="Turns draw mode off after a capture on this PC, so the mouse works normally again (captures from the tablet never change it)">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Exit draw mode on capture" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Stop drawing once a capture is taken" Style="{StaticResource RowDesc}" />
                                    </StackPanel>
                                    <CheckBox x:Name="ExitDrawOnCaptureCheck" Grid.Column="1" Margin="12,0,0,0"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="Exit draw mode on capture"
                                              Checked="CaptureBehavior_Changed" Unchecked="CaptureBehavior_Changed" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderBrushMuted}" Margin="0,14" />

                                <Grid ToolTip="Wipes your on-screen drawing after a capture on this PC. The capture keeps the ink as editable strokes (captures from the tablet never change it)">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Clear drawing after capture" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Start the next sketch on a clean screen" Style="{StaticResource RowDesc}" />
                                    </StackPanel>
                                    <CheckBox x:Name="ClearAfterCaptureCheck" Grid.Column="1" Margin="12,0,0,0"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="Clear drawing after capture"
                                              Checked="CaptureBehavior_Changed" Unchecked="CaptureBehavior_Changed" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderBrushMuted}" Margin="0,14" />

                                <Grid ToolTip="Leaves this toolbar in the picture instead of hiding it for the instant of the grab. It never appears in the stream sent to the tablet.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Capture toolbar in screen grabs" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Off = the toolbar is hidden for the grab" Style="{StaticResource RowDesc}" />
                                    </StackPanel>
                                    <CheckBox x:Name="ToolbarInGrabsCheck" Grid.Column="1" Margin="12,0,0,0"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="Capture toolbar in screen grabs"
                                              Checked="CaptureBehavior_Changed" Unchecked="CaptureBehavior_Changed" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderBrushMuted}" Margin="0,14" />

                                <Grid ToolTip="Pass-through hides the toolbar until you turn draw mode on (shortcut still works)">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Auto-hide toolbar" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Hide it while not drawing" Style="{StaticResource RowDesc}" />
                                    </StackPanel>
                                    <CheckBox x:Name="HideToolbarWhenNotDrawingCheck" Grid.Column="1" Margin="12,0,0,0"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="Hide toolbar when not drawing"
                                              Checked="HideToolbarWhenNotDrawing_Changed" Unchecked="HideToolbarWhenNotDrawing_Changed" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderBrushMuted}" Margin="0,14" />

                                <Grid ToolTip="On: pen, line, arrow, rectangle and ellipse share one button with a picker. Off: each has its own button.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Compact tools" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Fold pen and shapes into one button" Style="{StaticResource RowDesc}" />
                                    </StackPanel>
                                    <CheckBox x:Name="CompactToolsCheck" Grid.Column="1" Margin="12,0,0,0"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="Compact toolbar tools"
                                              Checked="CompactTools_Changed" Unchecked="CompactTools_Changed" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderBrushMuted}" Margin="0,14" />

                                <TextBlock Text="REMOTE SKETCHING" Style="{StaticResource SectionLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Sketching server" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Stream this screen to paired tablets and phones on your LAN"
                                                   Style="{StaticResource RowDesc}" />
                                    </StackPanel>
                                    <CheckBox x:Name="RemoteServerCheck" Grid.Column="1" Margin="12,0,0,0"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="Enable remote sketching server"
                                              Checked="RemoteServerCheck_Changed" Unchecked="RemoteServerCheck_Changed" />
                                </Grid>
                                <Button Content="Pair a device…" Click="PairRemote_Click" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />

                                <Border Height="1" Background="{StaticResource BorderBrushMuted}" Margin="0,16,0,14" />

                                <TextBlock Text="UPDATES" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="Current version" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="CurrentVersionText" Text="—" Style="{StaticResource RowDesc}" />
                                <TextBlock Text="Last checked" Style="{StaticResource RowTitle}" Margin="0,10,0,0" />
                                <TextBlock x:Name="LastCheckedText" Text="Never" Style="{StaticResource RowDesc}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="CheckForUpdatesButton" Content="Check now" MinWidth="96"
                                            Style="{StaticResource SettingsAction}" Click="CheckForUpdatesButton_Click"
                                            AutomationProperties.Name="Check for updates now" />
                                </StackPanel>
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource RowDesc}" Margin="0,8,0,0"
                                           TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrushMuted}" Margin="20,0" />

                            <!-- Right: stream quality -->
                            <remote:RemoteStreamSettingsControl x:Name="StreamSettings" Grid.Column="2" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Border>
</Window>
