<UserControl x:Class="OverInk.Toolbar.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="212">
    <Border Background="#FF161618" BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="1"
            CornerRadius="10" Padding="12">
        <StackPanel>
            <TextBlock Text="Color" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid HorizontalAlignment="Center">
                <Image x:Name="WheelImage" Width="176" Height="176" Cursor="Cross"
                       MouseLeftButtonDown="Wheel_MouseLeftButtonDown"
                       MouseMove="Wheel_MouseMove"
                       MouseLeftButtonUp="Wheel_MouseLeftButtonUp"
                       LostMouseCapture="Wheel_LostMouseCapture" />
                <Canvas x:Name="MarkerCanvas" Width="176" Height="176" IsHitTestVisible="False">
                    <Ellipse x:Name="PickerMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2"
                             Fill="Transparent" Visibility="Collapsed" />
                </Canvas>
            </Grid>
            <TextBlock Text="Brightness" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,10,0,4" />
            <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="100"
                    ValueChanged="BrightnessSlider_ValueChanged" />
            <Border Height="32" CornerRadius="6" Margin="0,10,0,0" BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush x:Name="PreviewBrush" Color="#E53935" />
                </Border.Background>
            </Border>
            <TextBlock x:Name="HexLabel" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</UserControl>
