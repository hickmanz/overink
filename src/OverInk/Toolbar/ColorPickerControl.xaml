<UserControl x:Class="OverInk.Toolbar.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="212">
    <!-- Hosted inside the color popover card, so no card chrome of its own. -->
    <StackPanel>
        <Grid HorizontalAlignment="Center">
            <Image x:Name="WheelImage" Width="176" Height="176" Cursor="Cross"
                   MouseLeftButtonDown="Wheel_MouseLeftButtonDown"
                   MouseMove="Wheel_MouseMove"
                   MouseLeftButtonUp="Wheel_MouseLeftButtonUp"
                   LostMouseCapture="Wheel_LostMouseCapture" />
            <!-- The wheel bitmap has a hard, aliased rim (radius ~86 of 88). A WPF Ellipse draws its stroke INSIDE its
                 bounds, so a full-size ellipse (same as WheelSize) with a 2px stroke covers r 86..88 and hides the jagged edge. -->
            <Ellipse Width="176" Height="176" Stroke="#FF3F3F46" StrokeThickness="2" IsHitTestVisible="False" />
            <Canvas x:Name="MarkerCanvas" Width="176" Height="176" IsHitTestVisible="False">
                <Ellipse x:Name="PickerMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2"
                         Fill="Transparent" Visibility="Collapsed" />
            </Canvas>
        </Grid>
        <Grid Margin="0,14,0,6">
            <TextBlock Text="Brightness" Style="{StaticResource RowTitle}" />
        </Grid>
        <Slider x:Name="BrightnessSlider" Style="{StaticResource ThemedSlider}" Minimum="0" Maximum="100" Value="100"
                ValueChanged="BrightnessSlider_ValueChanged" />
        <Border Height="28" CornerRadius="8" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrushMuted}" BorderThickness="1">
            <Border.Background>
                <SolidColorBrush x:Name="PreviewBrush" Color="#E53935" />
            </Border.Background>
        </Border>
        <TextBlock x:Name="HexLabel" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="11"
                   HorizontalAlignment="Center" Margin="0,6,0,0" />
        <Button x:Name="SaveButton" Content="Save color" Style="{StaticResource SettingsAction}"
                HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="SaveButton_Click"
                ToolTip="Add this color to your saved colors" />
    </StackPanel>
</UserControl>
